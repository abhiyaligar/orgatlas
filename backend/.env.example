# Backend Server Environment Variables
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Relational and Operational Metadata Database (Strictly migrated via Alembic)
DATABASE_URL=sqlite:///./orgatlas.db

# FalkorDB Knowledge Graph Configuration
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=default
FALKORDB_PASSWORD=your_falkordb_cloud_password
FALKORDB_GRAPH_NAME=orgatlas

# Nebius LLM Inference Configuration (OpenAI-compatible)
NEBIUS_API_KEY=your_nebius_api_key
NEBIUS_API_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL_NAME=meta-llama/Meta-Llama-3.1-70B-Instruct

# MCP Context Server Security Token
MCP_API_TOKEN=your_mcp_auth_token
