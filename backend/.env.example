# Backend Server Environment Variables
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Relational and Operational Metadata Database (Strictly migrated via Alembic)
DATABASE_URL=sqlite:///./orgatlas.db

# FalkorDB Knowledge Graph Configuration
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=default
FALKORDB_PASSWORD=your_falkordb_cloud_password
FALKORDB_GRAPH_NAME=orgatlas_dev

# Nebius LLM Inference Configuration (OpenAI-compatible)
NEBIUS_API_KEY=your_nebius_api_key
NEBIUS_API_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL_NAME=meta-llama/Meta-Llama-3.1-70B-Instruct

# MCP Context Server Security Token
MCP_API_TOKEN=your_mcp_auth_token

# A second token, with different rights, for the tools that write. Leave it
# blank and the server stays read-only and every ingest is refused.
MCP_WRITE_API_TOKEN=your_mcp_write_token

# --- Track A: Repository Ingestion (E2B sandbox workers) ---
# Required for ingestion. Nothing is defaulted in config.py, so a missing
# setting surfaces as None and ingestion reports it rather than guessing.
# The sandbox clones and parses only. It never receives FalkorDB or Nebius
# credentials; the API process owns every database write.
E2B_API_KEY=your_e2b_api_key
# Must be built once with cpu_count=2, memory_mb=4096. The default 2 vCPU /
# 1024 MiB template is too small to clone the target repository.
E2B_INGEST_TEMPLATE=orgatlas-ingest
# Sandbox lifetime in seconds. Hobby plan caps continuous runtime at 1 hour.
E2B_SANDBOX_TIMEOUT=600
# Commits to ingest per repository. Bounds graph growth and free-tier memory.
INGEST_COMMIT_DEPTH=600
# Local cache for extracted graph payloads, so a re-ingest skips re-cloning.
INGEST_CACHE_DIR=data/ingest_cache

# MCP bearer authentication (app.mcp.auth)
# One shared secret, compared constant-time against the Authorization header.
# Several tokens may be comma-separated, so a secret can be rotated by running
# the old and the new alongside each other.
#
# In production the route is NOT mounted unless this is set. With no token,
# /mcp returns 404 rather than serving an open context server.
# In development the route mounts without a token and logs a warning.
#
# Set the Host header MCP is published at, or every production request is
# refused as a DNS-rebinding attempt. Comma-separated; `host:*` allows any port.
MCP_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000

# Extraction model. Defaults to the answer model. See Docs/DOCUMENTS.md for the
# measured difference; google/gemma-3-27b-it used 42% fewer tokens with no
# wall-clock win.
# NEBIUS_EXTRACTION_MODEL_NAME=google/gemma-3-27b-it

# --- Source bodies (optional) ------------------------------------------------
# File contents live here; the graph keeps pointers, not bytes. Without these
# the graph is still complete and every retrieval tool reports that the body is
# absent, so this is safe to leave unset while developing.
#
# All three are needed together. These are S3-compatible credentials for
# Supabase's S3 endpoint, which is what that access key pair authenticates
# against -- NOT the Storage REST API, which wants a service_role key instead.
# Project Settings -> API Keys -> S3 keys.
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=your_s3_access_key_id
SUPABASE_S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
# Any region is accepted by this endpoint; it is not used for placement.
SUPABASE_S3_REGION=ap-south-1

# Bucket for source bodies. Private by construction, and created on first
# ingest if it does not exist.
SOURCE_BUCKET=Orgatlas

# Bounds, all optional. The per-file ceiling matches what ingest already applies
# when it reads a file to describe it.
# SOURCE_MAX_FILE_BYTES=262144
# Ceiling on what one ingest ships out of the sandbox; a larger clone stores what
# fits and reports what it dropped.
# SOURCE_MAX_INGEST_BYTES=8388608
# Ceiling on what one retrieval call returns, so asking for a whole large file
# yields a bounded excerpt and says so.
# SOURCE_MAX_RETURN_BYTES=24576
